rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return doc != null ? doc.data : null;
    }

    function isLandlordOrAdmin() {
      let userData = getUserData();
      return isAuthenticated() && userData != null &&
        (userData.role == 'landlord' || userData.role == 'superAdmin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isLandlordOrAdmin());
      allow delete: if isLandlordOrAdmin();
    }

    // Units Collection
    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLandlordOrAdmin();
    }

    // Maintenance Tickets Collection
    match /maintenanceTickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLandlordOrAdmin();
    }

    // Audit Logs Collection (Immutable Circular Buffer)
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, write: if isLandlordOrAdmin();
    }

    // Tenant Documents Collection
    match /tenantDocuments/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }

    // Utility Rate Logs Collection
    match /utilityRateLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isLandlordOrAdmin();
    }
  }
}
